<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.assets.mapper.AssetStorageLocationMapper">
    
    <resultMap type="AssetStorageLocation" id="AssetStorageLocationResult">
        <result property="id"    column="id"    />
        <result property="place"    column="place"    />
        <result property="code"    column="code"    />
        <result property="status"    column="status"    />
        <result property="createTime"    column="create_time"    />
        <result property="createBy"    column="create_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="updateBy"    column="update_by"    />
    </resultMap>

    <sql id="selectAssetStorageLocationVo">
        select id, place, code, status, create_time, create_by, update_time, update_by from asset_storage_location
    </sql>

    <select id="selectAssetStorageLocationList" parameterType="AssetStorageLocation" resultMap="AssetStorageLocationResult">
        <include refid="selectAssetStorageLocationVo"/>
        <where>  
            <if test="place != null  and place != ''"> and place like concat('%', #{place}, '%')</if>
            <if test="code != null  and code != ''"> and code = #{code}</if>
            <if test="status != null "> and status = #{status}</if>
        </where>
    </select>
    
    <select id="selectAssetStorageLocationById" parameterType="Long" resultMap="AssetStorageLocationResult">
        <include refid="selectAssetStorageLocationVo"/>
        where id = #{id}
    </select>

    <insert id="insertAssetStorageLocation" parameterType="AssetStorageLocation" useGeneratedKeys="true" keyProperty="id">
        insert into asset_storage_location
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="place != null">place,</if>
            <if test="code != null">code,</if>
            <if test="status != null">status,</if>
            <if test="createTime != null">create_time,</if>
            <if test="createBy != null">create_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="updateBy != null">update_by,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="place != null">#{place},</if>
            <if test="code != null">#{code},</if>
            <if test="status != null">#{status},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
         </trim>
    </insert>

    <update id="updateAssetStorageLocation" parameterType="AssetStorageLocation">
        update asset_storage_location
        <trim prefix="SET" suffixOverrides=",">
            <if test="place != null">place = #{place},</if>
            <if test="code != null">code = #{code},</if>
            <if test="status != null">status = #{status},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteAssetStorageLocationById" parameterType="Long">
        delete from asset_storage_location where id = #{id}
    </delete>

    <delete id="deleteAssetStorageLocationByIds" parameterType="String">
        delete from asset_storage_location where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>