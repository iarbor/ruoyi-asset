<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.assets.mapper.AssetLocationMapper">
    
    <resultMap type="AssetLocation" id="AssetLocationResult">
        <result property="id"    column="id"    />
        <result property="name"    column="name"    />
        <result property="code"    column="code"    />
        <result property="type"    column="type"    />
        <result property="status"    column="status"    />
        <result property="descript"    column="descript"    />
        <result property="createTime"    column="create_time"    />
        <result property="createBy"    column="create_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="updateBy"    column="update_by"    />
    </resultMap>

    <sql id="selectAssetLocationVo">
        select id, name, code, type, status, descript, create_time, create_by, update_time, update_by from asset_location
    </sql>

    <select id="selectAssetLocationList" parameterType="AssetLocation" resultMap="AssetLocationResult">
        <include refid="selectAssetLocationVo"/>
        <where>  
            <if test="name != null  and name != ''"> and name like concat('%', #{name}, '%')</if>
            <if test="code != null  and code != ''"> and code = #{code}</if>
            <if test="type != null  and type != ''"> and type = #{type}</if>
            <if test="status != null "> and status = #{status}</if>
            <if test="descript != null  and descript != ''"> and descript = #{descript}</if>
        </where>
    </select>
    
    <select id="selectAssetLocationById" parameterType="Long" resultMap="AssetLocationResult">
        <include refid="selectAssetLocationVo"/>
        where id = #{id}
    </select>

    <insert id="insertAssetLocation" parameterType="AssetLocation" useGeneratedKeys="true" keyProperty="id">
        insert into asset_location
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="name != null">name,</if>
            <if test="code != null">code,</if>
            <if test="type != null">type,</if>
            <if test="status != null">status,</if>
            <if test="descript != null">descript,</if>
            <if test="createTime != null">create_time,</if>
            <if test="createBy != null">create_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="updateBy != null">update_by,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="name != null">#{name},</if>
            <if test="code != null">#{code},</if>
            <if test="type != null">#{type},</if>
            <if test="status != null">#{status},</if>
            <if test="descript != null">#{descript},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
         </trim>
    </insert>

    <update id="updateAssetLocation" parameterType="AssetLocation">
        update asset_location
        <trim prefix="SET" suffixOverrides=",">
            <if test="name != null">name = #{name},</if>
            <if test="code != null">code = #{code},</if>
            <if test="type != null">type = #{type},</if>
            <if test="status != null">status = #{status},</if>
            <if test="descript != null">descript = #{descript},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteAssetLocationById" parameterType="Long">
        delete from asset_location where id = #{id}
    </delete>

    <delete id="deleteAssetLocationByIds" parameterType="String">
        delete from asset_location where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>